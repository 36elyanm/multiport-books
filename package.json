{
  "name": "multiport-books",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:assets": "node scripts/generate-pdf-asset.mjs",
    "dev": "npm run generate:assets && next dev",
    "build": "npm run generate:assets && next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "npm run generate:assets && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "pages:build": "npm run cf:build && node scripts/pages-worker-layout.mjs",
    "pages:preview": "npm run pages:build && wrangler pages dev .open-next/assets --compatibility-date=2026-08-03 --compatibility-flags=nodejs_compat",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .open-next/assets --compatibility-date=2026-08-03 --compatibility-flags=nodejs_compat"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
