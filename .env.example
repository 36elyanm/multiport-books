# Copy this file to .env.local and fill in real values to enable live payments.
# Without these, the site automatically falls back to a built-in demo
# checkout that simulates the $1 payment with no real charge.

# Stripe secret key (starts with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=

# Optional: fixes the demo-mode signing secret across server restarts.
# Only used when STRIPE_SECRET_KEY is unset. Safe to leave blank.
APP_SECRET=
